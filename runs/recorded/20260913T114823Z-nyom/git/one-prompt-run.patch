+import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
+import { HttpClickHouseClient } from "./runtime/clickhouse.ts";
+import { Guardian } from "./runtime/guardian.ts";
+import { JsonRpcChainHead } from "./runtime/rpc.ts";
+import { registerTools } from "./runtime/tools.ts";
+import type { Manifest, RuntimeReceipt } from "./runtime/types.ts";
+import { inputShapes } from "./tools.generated.ts";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const pkgRoot = resolve(here, "..");
+const log = (m: string): void => { process.stderr.write(`[@ethonline26/mcp-vaultflows] ${m}\n`); };
+
+const manifest = JSON.parse(readFileSync(join(pkgRoot, "manifest.json"), "utf8")) as Manifest;
+const receiptPath = process.env.RECEIPT_PATH ?? join(pkgRoot, "receipt.json");
+const readReceipt = (): Promise<RuntimeReceipt> =>
+  new Promise((ok, fail) => readFile(receiptPath, "utf8", (err, text) => (err ? fail(err) : ok(JSON.parse(text) as RuntimeReceipt))));
+const receiptAtStart = JSON.parse(readFileSync(receiptPath, "utf8")) as RuntimeReceipt;
+
+const chUrl = new URL(process.env.CLICKHOUSE_URL ?? "http://localhost:8123");
+const receiptSink = (receiptAtStart as { sink?: { database?: string } }).sink;
+const database = process.env.CLICKHOUSE_DATABASE ?? chUrl.searchParams.get("database") ?? receiptSink?.database ?? "default";
+const user = process.env.CLICKHOUSE_USER ?? (chUrl.username ? decodeURIComponent(chUrl.username) : undefined);
+const password = process.env.CLICKHOUSE_PASSWORD ?? (chUrl.password ? decodeURIComponent(chUrl.password) : undefined);
+const readonlyEnv = process.env.CLICKHOUSE_READONLY;
+const clickhouse = new HttpClickHouseClient({
+  url: `${chUrl.protocol}//${chUrl.host}`,
+  ...(user !== undefined ? { user } : {}),
+  ...(password !== undefined ? { password } : {}),
