# Copy to .env (git-ignored). Local development defaults only — these credentials
# exist solely inside the local `vaultflows-ch` Docker container (docs/build/clickhouse-local.md).

# --- Local ClickHouse (docker container: vaultflows-ch) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=vaultflows
# writer (used by substreams-sink-sql)
CLICKHOUSE_USER=sink
CLICKHOUSE_PASSWORD=sinkpass
# read-only (used by backend / MCP tools)
CLICKHOUSE_RO_USER=ro
CLICKHOUSE_RO_PASSWORD=ropass
# substreams-sink-sql DSN: native TCP port only (HTTP ports are rejected by the sink)
CLICKHOUSE_DSN=clickhouse://sink:sinkpass@localhost:9000/vaultflows
# read-only HTTP endpoint for queries
CLICKHOUSE_RO_HTTP_URL=http://ro:ropass@localhost:8123/?database=vaultflows

# --- Substreams ---
# JWT from `substreams auth` (writes .substreams.env) or The Graph Market. Never commit a real value.
SUBSTREAMS_API_TOKEN=
# Base mainnet endpoints: StreamingFast (below) or Pinax: base.substreams.pinax.network:443
SUBSTREAMS_ENDPOINT=base-mainnet.streamingfast.io:443
