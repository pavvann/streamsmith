+
+const maxLagBlocks = Number(process.env.MAX_LAG_BLOCKS ?? manifest.policy.maxLagBlocksDefault);
+const checkIntervalMs = Number(process.env.CHECK_INTERVAL_SECONDS ?? manifest.policy.checkIntervalSeconds) * 1000;
