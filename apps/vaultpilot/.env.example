# Privy app credentials (Dashboard > Configuration > App settings > Basics)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Human (treasurer) authorization key: P-256 private key, base64 PKCS8, as shown by the
# Dashboard (Wallets > Authorization keys > New key). The "wallet-auth:" prefix is accepted.
# This key OWNS the business wallet and the policy. Never give it to the agent.
PRIVY_AUTH_KEY=

# Agent authorization key: a second P-256 private key (Dashboard "New key", or
# `openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -outform DER | base64`).
# The spike registers its public key as a 1-of-1 key quorum and attaches it as an additional signer.
PRIVY_AGENT_AUTH_KEY=

# Privy Earn vault ids, app-specific, copied from Dashboard > Wallet infrastructure > Earn after
# deploying the fee wrapper for each Morpho vault (both USDC on Base mainnet, eip155:8453).
PRIVY_VAULT_ID_GAUNTLET=
PRIVY_VAULT_ID_STEAKHOUSE=

# Optional: a third vault id that is NOT in the allowlist, used by the spike's denial test.
# If unset the spike uses a syntactically valid placeholder id.
PRIVY_VAULT_ID_UNAPPROVED=

# Optional: caps in USD (== USDC for these vaults). Defaults: 60 per action, 120 per day.
# Per-action cap must exceed the funded position (~50 USDC) or a full rotation withdraw is denied.
VAULTPILOT_PER_ACTION_CAP_USD=60
VAULTPILOT_DAILY_CAP_USD=120

# Base mainnet RPC (used by later maxWithdraw/liquidity checks; not required by the spike)
BASE_RPC_URL=https://mainnet.base.org

# --- Data source (the decision service reads the erc4626-flows sink, never writes) ---
# VAULTPILOT_SOURCE=local | cloud | fixture | auto (default auto: local if CLICKHOUSE_URL is set,
# else ClickHouse Cloud, else the fixture in VAULTPILOT_FIXTURE / fixtures/rotate.json).
VAULTPILOT_SOURCE=
VAULTPILOT_FIXTURE=
# Local Docker ClickHouse: prefer the READ-ONLY user; the repo root .env's CLICKHOUSE_USER is the
# sink's writer and must not be used here.
CLICKHOUSE_RO_USER=ro
CLICKHOUSE_RO_PASSWORD=ropass
# ClickHouse Cloud credentials live in the repo root .env (CH_CLOUD_URL / CH_CLOUD_RO_USER /
# CH_CLOUD_RO_PASSWORD / CH_CLOUD_DATABASE) and are loaded from there.

# Decision rule (docs/PROJECT.md 4.3). Never lower the differential to manufacture a rotation.
VAULTPILOT_MIN_OBSERVATION_HOURS=24
VAULTPILOT_MIN_DIFFERENTIAL_BPS=2
VAULTPILOT_COOLDOWN_HOURS=6
VAULTPILOT_OUTFLOW_GUARDRAIL_BPS=1000
VAULTPILOT_MAX_LAG_BLOCKS=300
VAULTPILOT_WATCH_MINUTES=10
VAULTPILOT_SERVE_PORT=8787
