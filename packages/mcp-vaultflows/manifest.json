    {
      "name": "share_value_growth",
      "kind": "view",
      "source": "share_value_growth",
      "description": "Per configured vault: first and last share-value observation in the observed window (block numbers, timestamps, assets per share) and growth = last / first - 1. Only observations with call_ok = true; never interpolated.",
      "columns": [
        {
          "name": "vault",
          "type": "String",
          "stringify": false,
          "comment": "vault address, lowercase 0x hex"
        },
        {
          "name": "first_block_number",
          "type": "UInt64",
          "stringify": false,
          "comment": "block of the first observation in the window"
        },
        {
          "name": "first_block_timestamp",
          "type": "UInt64",
          "stringify": false,
          "comment": "unix seconds of the first observation"
        },
        {
          "name": "first_assets_per_share_normalized",
          "type": "Decimal(38, 18)",
          "stringify": true,
          "comment": "convertToAssets(10^share_decimals) / 10^asset_decimals at the first observation"
        },
        {
          "name": "last_block_number",
          "type": "UInt64",
          "stringify": false,
          "comment": "block of the last observation in the window"
        },
        {
          "name": "last_block_timestamp",
          "type": "UInt64",
          "stringify": false,
          "comment": "unix seconds of the last observation"
        },
        {
          "name": "last_assets_per_share_normalized",
          "type": "Decimal(38, 18)",
          "stringify": true,
          "comment": "assets per share at the last observation"
        },
        {
          "name": "growth",
          "type": "Nullable(Float64)",
          "stringify": false,
          "comment": "last_assets_per_share_normalized / first_assets_per_share_normalized - 1; NULL when the first value is zero"
        },
        {
          "name": "observed_hours",
          "type": "Float64",
          "stringify": false,
          "comment": "(last_block_timestamp - first_block_timestamp) / 3600"
        },
        {
          "name": "observation_count",
          "type": "UInt64",
          "stringify": false,
          "comment": "call_ok observations in the window"
        }
      ],
      "params": [
        {
          "name": "vault",
          "kind": "vault",
          "column": "vault",
          "values": [
            "0x050ce30b927da55177a4914ec73480238bad56f0",
            "0xbeef0e0834849acc03f0089f01f4f1eeb06873c9"
          ],
          "chType": "String",
          "description": "Restrict to one vault. Only the 2 vault(s) pinned by the Deployment Receipt are accepted (lowercase 0x hex)."
        },
        {
          "name": "windowHours",
          "kind": "windowHours",
          "min": 1,
          "max": 2160,
          "description": "Trailing window in hours, measured back from the newest observed row. Omit for the entire observed window. 1..2160.",
          "optional": true
        },
        {
          "name": "limit",
          "kind": "limit",
          "min": 1,
          "max": 500,
          "default": 100,
          "description": "Maximum rows returned, 1..500 (default 100)."
        }
      ],
      "deletedFilter": false,
      "orderBy": [
        "vault ASC"
      ],
      "window": {
        "column": "block_timestamp",
        "table": "share_value_observations",
        "where": "_deleted_ = 0 AND call_ok = true",
        "marker": true
      },
      "body": "SELECT\n  vault,\n  min(block_number) AS first_block_number,\n  argMin(block_timestamp, block_number) AS first_block_timestamp,\n  argMin(assets_per_share_normalized, block_number) AS first_assets_per_share_normalized,\n  max(block_number) AS last_block_number,\n  argMax(block_timestamp, block_number) AS last_block_timestamp,\n  argMax(assets_per_share_normalized, block_number) AS last_assets_per_share_normalized,\n  if(first_assets_per_share_normalized = 0, NULL,\n     toFloat64(last_assets_per_share_normalized) / toFloat64(first_assets_per_share_normalized) - 1) AS growth,\n  (last_block_timestamp - first_block_timestamp) / 3600 AS observed_hours,\n  count() AS observation_count\nFROM share_value_observations\nWHERE _deleted_ = 0 AND call_ok = true /*@window*/\nGROUP BY vault"
    },
