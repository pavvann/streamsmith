# Streamsmith environment. Copy to the repo root .env (git-ignored) or export in the shell.
# Nothing here is read at import time — every value is looked up when the command that needs it runs,
# so a missing variable produces a named error, never a silent skip.

# --- Substreams data plane (gate, publish, self-managed sink) ---
# JWT from `substreams auth` (it writes .substreams.env) or from The Graph Market.
# Either name works; specs/gate.yaml auth.envAny lists both. Without one, `streamsmith gate` exits 20 with
# "rpc error: code = Unauthenticated" in runs/<id>/<run>.stderr.log.
SUBSTREAMS_API_TOKEN=
# SUBSTREAMS_API_KEY=

# --- The Graph Market Portal API (hosted deploy: deploy hosted / deploy status / deploy stop) ---
# Bearer token for api.thegraph.market — NOT the same credential as SUBSTREAMS_API_TOKEN.
# `streamsmith deploy login` performs the device-code flow and prints export lines; it never stores tokens.
PORTAL_TOKEN=
PORTAL_ORG_ID=

# --- ClickHouse (deploy views, deploy status, schema-dump) ---
# HTTP endpoint used for queries and for applying packages/erc4626-flows/sql/views.sql.
# CLICKHOUSE_USER / CLICKHOUSE_PASSWORD are merged into CLICKHOUSE_URL when it carries no credentials.
# The hosted deploy never sends a password: it is staged once by a human on the Portal secret page.
CLICKHOUSE_URL=http://localhost:8123/
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=

# --- Base RPC (warn-level gate cross-checks only) ---
# log_index_matches_rpc (eth_getTransactionReceipt) and observation_matches_reference (eth_call convertToAssets at
# the sampled block). Both are severity: warn — when this endpoint is unreachable the checks are skipped with a note
# and the exit code does not change. `streamsmith gate --offline` skips them without trying.
BASE_RPC_URL=https://mainnet.base.org
