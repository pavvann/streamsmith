diff --git a/packages/erc4626-flows/proto/vaultflows.proto b/packages/erc4626-flows/proto/vaultflows.proto
new file mode 100644
index 0000000..27a125e
--- /dev/null
+++ b/packages/erc4626-flows/proto/vaultflows.proto
@@ -0,0 +1,179 @@
+// Public output contract for the `erc4626-flows` Substreams package (Base, chain id 8453).
+// This file is frozen before the recorded one-prompt run; the gate compares the normalized
+// descriptor hash of the built package against this file (specs/gate.yaml -> descriptor_hash_match).
+//
+// Conventions
+// - Addresses and hashes are lowercase hex strings with a 0x prefix (block_hash, tx_hash, vault, caller, owner,
+//   receiver, asset, from_owner, to_owner).
+// - *_raw fields are unsigned 256-bit integers rendered as decimal digit strings (proto3 has no uint256).
+// - *_normalized fields and execution_rate are non-negative decimal strings ("123.456", at most 18 fractional
+//   digits, no sign, no exponent) scaled by the relevant token decimals.
+// - A numeric string is NEVER empty. When a value is not computable (meta_valid false, call_ok false, or a zero
+//   divisor) it is the string "0" and the accompanying flag (meta_valid / call_ok) tells the consumer to ignore it.
+//   Reason: the ClickHouse from-proto sink panics on an empty string for a convertTo column.
+// - Nothing is interpolated between observations.
+// - Row ids are deterministic so replays and restarts are idempotent (the from-proto sink allows exactly one
+//   primary key per table; the id is also the first ORDER BY column).
+//     VaultFlow / ShareTransfer : "{chain_id}-{block_number}-{log_index}"   e.g. "8453-51092263-406"
+//     ShareValueObservation     : "{chain_id}-{block_number}-{vault}"       e.g. "8453-51093000-0x050c...56f0"
+//     VaultMeta                 : "{chain_id}-{vault}"                      e.g. "8453-0x050c...56f0"
+//   log_index is the receipt log index within the block (Firehose Log.blockIndex, the logIndex of eth_getLogs),
+//   which is unique per block, so tx_hash is not needed in the id.
+// - Call-status flags are flattened to scalar columns (call_ok, call_error) because the from-proto sink drops
+//   message-typed fields that are not google.protobuf.Timestamp or inline.
+// - There are no enum fields in this contract. `substreams-sink-sql` 4.13.1 `from-proto` panics on a populated
+//   proto3 enum field (`interface {} is protoreflect.EnumNumber, not int32`, ClickHouse
+//   accumulator_inserter.go), so `VaultFlow.direction` is a plain String column holding exactly
+//   "deposit" or "withdraw" (lowercase, never empty).
+// - Vocabulary: "execution rate" (assets per share implied by one flow), "share value" (assets per share
+//   observed by convertToAssets at a sampled block), "share migration" (transfer of shares between owners).
+
+syntax = "proto3";
+
+package vaultflows.v1;
+
+import "sf/substreams/sink/sql/schema/v1/schema.proto";
+
+// Output of the single sink module. Each repeated field maps to one ClickHouse table.
+message Events {
+  repeated VaultFlow vault_flows = 1;
+  repeated ShareValueObservation share_value_observations = 2;
+  repeated VaultMeta vaults = 3;
+  repeated ShareTransfer share_transfers = 4;
+}
+
+// One Deposit or Withdraw log on a vault in the configured vault list.
+message VaultFlow {
+  option (schema.table) = {
+    name: "vault_flows"
+    clickhouse_table_options: {
+      order_by_fields: [{ name: "id" }, { name: "vault" }, { name: "block_number" }]
+      partition_fields: [{ name: "_block_timestamp_", function: toYYYYMM }]
+    }
+  };
+
+  reserved 21;
+  reserved "call_status";
+
+  // "{chain_id}-{block_number}-{log_index}"
+  string id = 1 [(schema.field) = { primary_key: true }];
+  uint32 chain_id = 2;
+  uint64 block_number = 3;
+  string block_hash = 4;
+  uint64 block_timestamp = 5;  // unix seconds
+  string tx_hash = 6;
+  uint32 log_index = 7;        // receipt log index within the block (block-wide, not per-transaction)
+  string vault = 8;
+  string caller = 9;           // event `sender`: the address that called deposit/mint/withdraw/redeem
+  string owner = 10;           // whose shares were minted (deposit) or burned (withdraw)
+  string receiver = 11;        // who received assets on withdraw; equals owner on deposit
+  // Values exactly `deposit` (ERC-4626 Deposit(sender, owner, assets, shares)) or `withdraw`
+  // (ERC-4626 Withdraw(sender, receiver, owner, assets, shares)). Lowercase, never empty.
+  string direction = 12;
+  string assets_raw = 13 [(schema.field) = { convertTo: { uint256{} } }];
+  string shares_raw = 14 [(schema.field) = { convertTo: { uint256{} } }];
+  string assets_normalized = 15 [(schema.field) = { convertTo: { decimal128{ scale: 18 } } }];  // assets_raw / 10^asset_decimals; "0" when meta_valid is false
+  string shares_normalized = 16 [(schema.field) = { convertTo: { decimal128{ scale: 18 } } }];  // shares_raw / 10^share_decimals; "0" when meta_valid is false
+  uint32 asset_decimals = 17;  // 0 when meta_valid is false
+  uint32 share_decimals = 18;  // 0 when meta_valid is false
+  // assets_normalized / shares_normalized for this single flow, in asset units per whole share. Deposit-implied
+  // when direction is `deposit` (per EIP-4626 the Deposit `assets` includes any entry fee); withdraw-implied when
+  // `withdraw` (Withdraw `assets` is net of exit fee). "0" when shares_raw is zero or meta_valid is false.
+  string execution_rate = 19 [(schema.field) = { convertTo: { decimal128{ scale: 18 } } }];
+  // true when the vault passed the first-sight metadata probe (asset(), decimals(), asset.decimals(),
+  // totalAssets(), convertToAssets()) and the normalized fields are populated.
+  bool meta_valid = 20;
+  bool call_ok = 22;      // status of the metadata probe this row relied on: true when every call returned and decoded
+  string call_error = 23; // empty when call_ok; otherwise a short reason, e.g. "convertToAssets: reverted"
+}
+
+// Point-in-time read of a vault at a sampled block (block_number % sample_interval_blocks == 0).
+// One row per configured vault per sampled block, emitted even when the calls fail (call_ok = false).
+message ShareValueObservation {
+  option (schema.table) = {
+    name: "share_value_observations"
+    clickhouse_table_options: {
+      order_by_fields: [{ name: "id" }, { name: "vault" }, { name: "block_number" }]
+      partition_fields: [{ name: "_block_timestamp_", function: toYYYYMM }]
+    }
+  };
+
+  reserved 12;
+  reserved "call_status";
+
+  // "{chain_id}-{block_number}-{vault}"
+  string id = 1 [(schema.field) = { primary_key: true }];
+  uint32 chain_id = 2;
+  uint64 block_number = 3;
+  string block_hash = 4;
+  uint64 block_timestamp = 5;  // unix seconds
+  string vault = 6;
+  uint32 sample_interval_blocks = 7;
+  // convertToAssets(10^share_decimals) executed at this block's state. "0" when call_ok is false.
+  string assets_per_share_raw = 8 [(schema.field) = { convertTo: { uint256{} } }];
+  // assets_per_share_raw / 10^asset_decimals (assets per one whole share). "0" when call_ok is false.
+  string assets_per_share_normalized = 9 [(schema.field) = { convertTo: { decimal128{ scale: 18 } } }];
+  string total_assets_raw = 10 [(schema.field) = { convertTo: { uint256{} } }];  // totalAssets(); "0" when call_ok is false
+  string total_supply_raw = 11 [(schema.field) = { convertTo: { uint256{} } }];  // totalSupply(); "0" when call_ok is false
+  bool call_ok = 13;      // true only if convertToAssets, totalAssets and totalSupply all returned and decoded
+  string call_error = 14; // empty when call_ok; otherwise a short reason naming the failed call
+}
+
+// First-sight metadata of every address that emitted a matching Deposit/Withdraw. One row per vault
+// per chain, written when the probe first runs. Non-compliant addresses are recorded with compliant=false
+// and never produce VaultFlow rows.
+message VaultMeta {
+  option (schema.table) = {
+    name: "vaults"
+    clickhouse_table_options: {
+      order_by_fields: [{ name: "id" }]
+      partition_fields: [{ name: "_block_timestamp_", function: toYYYYMM }]
+    }
+  };
+
+  reserved 12;
+  reserved "call_status";
+
+  // "{chain_id}-{vault}"
+  string id = 1 [(schema.field) = { primary_key: true }];
+  uint32 chain_id = 2;
+  string vault = 3;
+  uint64 first_seen_block = 4;   // block at which the probe ran
+  string asset = 5;              // asset() result; empty if the probe failed (plain string column, empty is allowed)
+  uint32 asset_decimals = 6;     // 0 if the probe failed
+  uint32 share_decimals = 7;     // 0 if the probe failed
+  string name = 8;               // name() if decodable, else empty
+  string symbol = 9;             // symbol() if decodable, else empty
+  bool compliant = 10;           // heuristic: all probe calls succeeded and decoded
+  bool in_configured_list = 11;  // true when the address is in the package's vault parameter
+  bool call_ok = 13;      // true when every probe call returned and decoded (equals compliant in v0.1.0)
+  string call_error = 14; // empty when call_ok; otherwise the first failed call, e.g. "asset: reverted"
+}
+
+// ERC-20 Transfer of vault shares between two owners (share migration), excluding the mint on
+// Deposit (from = 0x0) and the burn on Withdraw (to = 0x0). Optional table; may be empty in v0.1.0.
+message ShareTransfer {
+  option (schema.table) = {
+    name: "share_transfers"
+    clickhouse_table_options: {
+      order_by_fields: [{ name: "id" }, { name: "vault" }, { name: "block_number" }]
+      partition_fields: [{ name: "_block_timestamp_", function: toYYYYMM }]
+    }
+  };
+
+  // "{chain_id}-{block_number}-{log_index}"
+  string id = 1 [(schema.field) = { primary_key: true }];
+  uint32 chain_id = 2;
+  uint64 block_number = 3;
+  string block_hash = 4;
+  uint64 block_timestamp = 5;
+  string tx_hash = 6;
+  uint32 log_index = 7;
+  string vault = 8;
+  string from_owner = 9;   // Transfer `from` (renamed: bare `to` is a ClickHouse keyword and the sink emits unquoted identifiers)
+  string to_owner = 10;    // Transfer `to`
+  string shares_raw = 11 [(schema.field) = { convertTo: { uint256{} } }];
+  string shares_normalized = 12 [(schema.field) = { convertTo: { decimal128{ scale: 18 } } }];  // "0" when meta_valid is false
+  uint32 share_decimals = 13;
+  bool meta_valid = 14;
+}
diff --git a/packages/erc4626-flows/sql/views.sql b/packages/erc4626-flows/sql/views.sql
new file mode 100644
index 0000000..5234541
--- /dev/null
+++ b/packages/erc4626-flows/sql/views.sql
@@ -0,0 +1,71 @@
+-- Views over the from-proto base tables. The sink owns the four base tables (created from the
+-- (schema.table) annotations in proto/vaultflows.proto); nothing here creates or alters them.
+--
+-- Every read filters `_deleted_ = 0`: the ClickHouse from-proto sink handles reorgs by inserting
+-- tombstone rows into a ReplacingMergeTree, so unfiltered reads can still see undone blocks.
+--
+-- The annotation comments below are the generator contract for @ethonline26/mcpgen: one names the
+-- view, one types each output column, and one declares the trailing-window predicate that the
+-- generated tool may splice in at the /*@window*/ marker.
+
+-- @view vault_flows_24h
+-- @description Per-vault deposit and withdrawal totals over the last 24 hours of observed data (the window ends at the newest vault_flows row, not at wall-clock now). Counts are of rows; assets are normalized underlying units. flows_without_metadata counts rows whose metadata probe had not settled, whose normalized amounts are therefore "0" and are excluded from the sums.
+-- @column vault String Vault address, lowercase 0x hex.
+-- @column window_end_timestamp UInt64 Unix seconds of the newest observed vault_flows row (upper bound of the window).
+-- @column window_start_timestamp UInt64 Unix seconds 24 hours before window_end_timestamp (lower bound of the window).
+-- @column deposit_count UInt64 Deposit rows in the window.
+-- @column withdraw_count UInt64 Withdraw rows in the window.
+-- @column assets_in_normalized Decimal(38, 18) Sum of assets_normalized over deposits in the window.
+-- @column assets_out_normalized Decimal(38, 18) Sum of assets_normalized over withdrawals in the window.
+-- @column net_assets_normalized Decimal(38, 18) assets_in_normalized minus assets_out_normalized.
+-- @column flows_without_metadata UInt64 Rows in the window with meta_valid = false (their amounts are not included in the sums).
+CREATE OR REPLACE VIEW vault_flows_24h AS
+WITH (SELECT max(block_timestamp) FROM vault_flows WHERE _deleted_ = 0) AS observed_end
+SELECT
+    vault,
+    toUInt64(ifNull(observed_end, 0)) AS window_end_timestamp,
+    toUInt64(ifNull(observed_end, 0) - 86400) AS window_start_timestamp,
+    countIf(direction = 'deposit') AS deposit_count,
+    countIf(direction = 'withdraw') AS withdraw_count,
+    sumIf(assets_normalized, direction = 'deposit') AS assets_in_normalized,
+    sumIf(assets_normalized, direction = 'withdraw') AS assets_out_normalized,
+    sumIf(assets_normalized, direction = 'deposit') - sumIf(assets_normalized, direction = 'withdraw') AS net_assets_normalized,
+    countIf(meta_valid = false) AS flows_without_metadata
+FROM vault_flows
+WHERE _deleted_ = 0
+  AND block_timestamp >= observed_end - 86400
+GROUP BY vault;
+
+-- @view share_value_growth
+-- @description Change in observed share value per vault: the first and last convertToAssets observation in the window, and the relative change between them. Reads only observations with call_ok = true; nothing is interpolated between samples, so growth is the change between two actual observations, not a rate.
+-- @window column=block_timestamp table=share_value_observations where=_deleted_ = 0 AND call_ok = true
+-- @column vault String Vault address, lowercase 0x hex.
+-- @column first_block_number UInt64 Block of the earliest observation in the window.
+-- @column first_block_timestamp UInt64 Unix seconds of that observation.
+-- @column first_assets_per_share_normalized Decimal(38, 18) Assets per whole share at the earliest observation.
+-- @column last_block_number UInt64 Block of the latest observation in the window.
+-- @column last_block_timestamp UInt64 Unix seconds of that observation.
+-- @column last_assets_per_share_normalized Decimal(38, 18) Assets per whole share at the latest observation.
+-- @column growth Nullable(Float64) last / first - 1, as a fraction. NULL when the first observation is zero.
+-- @column observed_hours Float64 Hours between the first and last observation in the window.
+-- @column observation_count UInt64 Observations counted in the window.
+CREATE OR REPLACE VIEW share_value_growth AS
+SELECT
+    vault,
+    min(block_number) AS first_block_number,
+    argMin(block_timestamp, block_number) AS first_block_timestamp,
+    argMin(assets_per_share_normalized, block_number) AS first_assets_per_share_normalized,
+    max(block_number) AS last_block_number,
+    argMax(block_timestamp, block_number) AS last_block_timestamp,
+    argMax(assets_per_share_normalized, block_number) AS last_assets_per_share_normalized,
+    if(
+        argMin(assets_per_share_normalized, block_number) > 0,
+        toFloat64(argMax(assets_per_share_normalized, block_number)) / toFloat64(argMin(assets_per_share_normalized, block_number)) - 1,
+        NULL
+    ) AS growth,
+    toFloat64(argMax(block_timestamp, block_number) - argMin(block_timestamp, block_number)) / 3600 AS observed_hours,
+    count() AS observation_count
+FROM share_value_observations
+WHERE _deleted_ = 0
+  AND call_ok = true /*@window*/
+GROUP BY vault;
